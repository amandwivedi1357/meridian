NODE_ENV=development
LOG_LEVEL=info

BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PRIVATE_KEY_PATH=

DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379
# Risk controls start engaged; see docs/risk-engine.md before enabling execution.
EXECUTOR_RISK_SYMBOLS=BTCUSDT
EXECUTOR_RISK_QUOTE_ASSET=USDT
# Optional, OFF by default. Requires authenticated initialization on a fresh,
# dedicated Testnet order/risk ledger; see docs/risk-engine.md.
# MERIDIAN_TESTNET_ALLOCATION={"id":"prototype","quoteAsset":"USDT","initialQuote":"100","symbols":["BTCUSDT"]}
EXECUTOR_MIN_NOTIONAL=5
EXECUTOR_MAX_NOTIONAL=25
EXECUTOR_MAX_QUANTITY=0.0002
EXECUTOR_MAX_POSITION=0.001
EXECUTOR_MAX_SYMBOL_EXPOSURE=100
EXECUTOR_MAX_GLOBAL_EXPOSURE=1000
EXECUTOR_MAX_OPEN_ORDERS=1
EXECUTOR_MAX_ORDERS_PER_MINUTE=5
EXECUTOR_MAX_DAILY_LOSS=50
EXECUTOR_MAX_DRAWDOWN=0.1
EXECUTOR_MAX_PRICE_DEVIATION=0.02
EXECUTOR_RISK_MAX_DATA_AGE_MS=5000
# Optional JSON overrides; monetary values must be decimal strings.
EXECUTOR_SYMBOL_RISK_LIMITS={}
EXECUTOR_STRATEGY_RISK_LIMITS={}
# Configure a private random token of at least 32 characters before operator control.
MERIDIAN_RISK_ADMIN_TOKEN=
# Supply MERIDIAN_RISK_CONTROL_TOKEN only in the operator's shell, not in this file.
# INGESTOR_SESSION_RECORDING_PATH=sessions/local/events.ndjson

JWT_SECRET=change-me-in-local-env
API_PORT=3000
WEB_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# docker start -ai meridian-git
