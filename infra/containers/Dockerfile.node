FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /build
ENV HUSKY=0
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts/containers/package.mjs ./scripts/containers/package.mjs
COPY scripts/prepare-husky.mjs ./scripts/prepare-husky.mjs
RUN pnpm install --frozen-lockfile
ARG SERVICE=api
RUN node scripts/containers/package.mjs "${SERVICE}"

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
COPY --chown=node:node scripts/containers/entrypoint.mjs scripts/containers/healthcheck.mjs ./container/
RUN mkdir -p logs reports sessions && chown node:node logs reports sessions
USER node
ENTRYPOINT ["node", "container/entrypoint.mjs"]

FROM runtime AS cli
HEALTHCHECK NONE

FROM runtime AS service
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 CMD ["node", "container/healthcheck.mjs"]
