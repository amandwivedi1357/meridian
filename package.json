{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven Binance Spot Testnet trading platform.",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dashboard:feed": "node --env-file=.env apps/ingestor/dist/dashboard-feed.js",
    "dashboard:feed:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dashboard-feed-task.ps1 -Action Install",
    "dashboard:feed:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dashboard-feed-task.ps1 -Action Stop",
    "dashboard:feed:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dashboard-feed-task.ps1 -Action Status",
    "build": "turbo run build",
    "backtest": "pnpm --filter @meridian/backtest-worker exec tsx src/main.ts",
    "backtest:list": "pnpm backtest list",
    "backtest:report": "pnpm backtest report",
    "backtest:show": "pnpm backtest show",
    "db:backup": "node scripts/db-backup.cjs backup",
    "db:backup:scheduled": "node scripts/db-backup.cjs scheduled",
    "db:backup:verify": "node scripts/db-backup.cjs verify",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
